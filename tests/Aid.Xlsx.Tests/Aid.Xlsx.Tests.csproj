<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the ported library. The TFM, the default culture and the shared build properties
    come from Directory.Build.props. Test packages are private (they do not flow to consumers).
  -->

  <PropertyGroup>
    <RootNamespace>Aid.Xlsx.Tests</RootNamespace>
    <AssemblyName>Aid.Xlsx.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <!--
      The test code is ported from upstream and deliberately passes null and uses
      nullable idioms without annotations, so nullable analysis is disabled for tests.
      All other warnings stay errors (the global TreatWarningsAsErrors).
    -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);NU1605;CS1591;CS1658;CS1584;</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="**\*.xlsx" Exclude="**\~$*.xlsx;bin\**" />
    <EmbeddedResource Include="**\*.xlsm" Exclude="**\~$*.xlsm;bin\**" />
    <EmbeddedResource Include="IO\biff8-*.xls" />
    <EmbeddedResource Include="Resource\Images\**\*.*" />
    <EmbeddedResource Include="Resource\Fonts\*.*" />
    <EmbeddedResource Include="Resource\Other\**\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="System.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Aid.Xlsx\Aid.Xlsx.csproj" />
    <ProjectReference Include="..\..\src\Aid.Xlsx.Formula\Aid.Xlsx.Formula.csproj" />
    <ProjectReference Include="..\..\src\Aid.Xlsx.Opc\Aid.Xlsx.Opc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Custom global usings added in the csproj file -->
    <Using Include="NUnit.Framework.Legacy" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="NUnit.Framework.SetCultureAttribute">
      <_Parameter1>en-US</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
