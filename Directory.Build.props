<Project>

  <!--
    Shared build properties for Aid.Xlsx: version, package metadata, analyzers, AOT/trim.
    MSBuild imports this file automatically for every project below the repository root.
    It is also the single source of the version and of the common package metadata:
    there is no separate versions file.

    The default target framework is net10.0; targeting .NET 11 is a separate task.
  -->

  <!-- ======================= Version (single source) ======================= -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview1</VersionSuffix>
    <Version Condition="'$(Version)' == '' and '$(VersionSuffix)' != ''">$(VersionPrefix)-$(VersionSuffix)</Version>
    <Version Condition="'$(Version)' == ''">$(VersionPrefix)</Version>
  </PropertyGroup>

  <!-- ======================= Package metadata =============================== -->
  <PropertyGroup>
    <Authors>Distaid</Authors>
    <RepositoryUrl>https://github.com/Distaid/aidxlsx</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Copyright>Copyright (c) 2026 Distaid</Copyright>
  </PropertyGroup>

  <!-- ======================= Build properties ============================== -->
  <PropertyGroup>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!--
      "latest" instead of "latest-recommended": the recommended set (CA1805/CA1859/CA1305/CA1822/
      CA1716 and others) reports about 650 findings on the imported sources. That is the state of
      the imported code, not a regression of this port. Returning to "latest-recommended" is a
      separate task after the CA baseline has been triaged.
    -->
    <AnalysisLevel>latest</AnalysisLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!--
      NuGet audit is not part of the build: fetching vulnerability data during restore makes the
      build depend on nuget.org availability and turns a transient network failure into a build
      error. Vulnerable dependencies are checked explicitly in CI by the dedicated
      "dotnet list package" step with the vulnerable flag.
    -->
    <NuGetAudit>false</NuGetAudit>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Single target framework: projects without an explicit TargetFramework get net10.0. -->
  <PropertyGroup Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- ======================= Assembly versions ============================= -->
  <PropertyGroup>
    <!-- AssemblyVersion changes only with major/minor: a predictable binding for consumers. -->
    <AssemblyVersion>$([System.Version]::Parse('$(VersionPrefix)').Major).$([System.Version]::Parse('$(VersionPrefix)').Minor).0.0</AssemblyVersion>
    <!-- FileVersion: major.minor.patch.<preview number, 0 for a stable release> -->
    <_AidPreviewNumber Condition="'$(VersionSuffix)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(VersionSuffix)', '\d+').Value)</_AidPreviewNumber>
    <_AidPreviewNumber Condition="'$(_AidPreviewNumber)' == ''">0</_AidPreviewNumber>
    <FileVersion>$([System.Version]::Parse('$(VersionPrefix)').Major).$([System.Version]::Parse('$(VersionPrefix)').Minor).$([System.Version]::Parse('$(VersionPrefix)').Build).$(_AidPreviewNumber)</FileVersion>
  </PropertyGroup>

  <!--
    Package validation baseline. Empty until the first published version; from the second
    version onwards it holds the published number and the project passes it to
    PackageValidationBaselineVersion.
  -->
  <PropertyGroup>
  </PropertyGroup>

  <!-- ======================= AOT/trim for libraries ======================= -->
  <!--
    IsTrimmable/IsAotCompatible and the trim/AOT/single-file analyzers are enabled only for
    library assemblies (marker: $(IsLibrary)). A project marks itself with IsLibrary=true in its
    csproj, but this file is imported before the project body, so at the time the condition below
    is evaluated the value from the csproj is not set yet. To keep the configuration in one place,
    library projects are listed here by name; the IsLibrary property in the csproj remains an
    explicit marker of the project. A new library project must be added to this list.
  -->
  <PropertyGroup>
    <IsLibrary Condition="'$(IsLibrary)' == '' and ('$(MSBuildProjectName)' == 'Aid.Xlsx' or '$(MSBuildProjectName)' == 'Aid.Xlsx.Opc')">true</IsLibrary>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsLibrary)' == 'true'">
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

</Project>