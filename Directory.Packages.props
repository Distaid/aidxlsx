<Project>

  <!--
    Central Package Management: shared package versions are defined here.
    Projects use <PackageReference Include="..." /> without a Version attribute.
    The standalone benchmark imports these versions and defines its own comparison dependencies.
  -->

  <ItemGroup>
    <!-- Runtime dependencies of the Aid.Xlsx library -->
    <PackageVersion Include="ExcelNumberFormat" Version="1.1.0" />
    <PackageVersion Include="Polyfill" Version="1.29.0" />
    <PackageVersion Include="RBush.Signed" Version="4.0.0" />
    <PackageVersion Include="SixLabors.Fonts" Version="1.0.0" />

    <!-- Build and packaging infrastructure -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="1.1.1" />

    <!-- Test dependencies -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="[3.1.1,4.0.0)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="NUnit" Version="4.5.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="5.2.0" />
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
    <PackageVersion Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

</Project>
