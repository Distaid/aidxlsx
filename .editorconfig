dotnet_diagnostic.SYSLIB1045.severity = warning

# Rules that are deliberately not enforced, with the reason next to each one.
# IDE0300: a collection expression has no valid target type in a few generic and
#          attribute contexts used here; the remaining sites stay reviewed by hand.
dotnet_diagnostic.IDE0300.severity = suggestion
# IDE0060: unused parameters are kept where they belong to a public signature or
#          to a delegate contract.
dotnet_diagnostic.IDE0060.severity = suggestion
# CA1517: the affected parameters are bound to the CalcEngineFunction delegate,
#         which takes Span<T>, so widening them to ReadOnlySpan<T> is impossible.
dotnet_diagnostic.CA1517.severity = suggestion
# CA1859: changing parameter and return types for performance is a design
#         decision, not a style rule; reviewed case by case.
dotnet_diagnostic.CA1859.severity = suggestion
# CA1822: the remaining member is public; making it static would break the API.
dotnet_diagnostic.CA1822.severity = suggestion
# CA1069: Hangeul/Hangul are an intentional alias for the same enum value.
dotnet_diagnostic.CA1069.severity = none
# CA2211: NoBomUTF8 is a public field; making it readonly is an API change.
dotnet_diagnostic.CA2211.severity = none
# CA2231: adding equality operators to XlsxCellValue is an API addition, not style.
dotnet_diagnostic.CA2231.severity = none

# CA2208 cannot be satisfied where the switch fallback is over a local value that
# is not a parameter of the enclosing method.
[src/Aid.Xlsx/Model/Grid/Cells/ValueSlice.cs]
dotnet_diagnostic.CA2208.severity = none