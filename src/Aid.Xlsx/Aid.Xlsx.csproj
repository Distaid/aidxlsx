<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The main Aid.Xlsx library: the Excel object model, part reading/writing, CalcEngine,
    styles, tables and drawings.
    The TFM, version, nullable and shared properties come from Directory.Build.props;
    IsLibrary turns on the library-wide trim/AOT settings and the matching analyzers.
  -->

  <PropertyGroup>
    <RootNamespace>Aid.Xlsx</RootNamespace>
    <AssemblyName>Aid.Xlsx</AssemblyName>
    <PackageId>Aid.Xlsx</PackageId>
    <Description>A .NET library for reading, creating, and editing Excel workbooks.</Description>
    <IsLibrary>true</IsLibrary>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      The OPC and formula libraries ship inside Aid.Xlsx. The target below bundles their
      assemblies and PrivateAssets keeps them out of the package dependency list.
    -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeProjectReferenceOutputs</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeSourceGenerator</TargetsForTfmSpecificContentInPackage>
    <NoWarn>$(NoWarn);NU1605;CS1591</NoWarn>
  </PropertyGroup>

  <Target Name="IncludeProjectReferenceOutputs">
    <ItemGroup>
      <BuildOutputInPackage Include="$(TargetDir)Aid.Xlsx.Opc.dll;$(TargetDir)Aid.Xlsx.Formula.dll" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeSourceGenerator">
    <MSBuild Projects="..\Aid.Xlsx.Generators\Aid.Xlsx.Generators.csproj" Targets="GetTargetPath"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed">
      <Output TaskParameter="TargetOutputs" ItemName="SourceGeneratorAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(SourceGeneratorAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <EmbeddedResource Include="Graphics\Fonts\CarlitoBare-Bold.ttf" />
    <EmbeddedResource Include="Graphics\Fonts\CarlitoBare-BoldItalic.ttf" />
    <EmbeddedResource Include="Graphics\Fonts\CarlitoBare-Italic.ttf" />
    <EmbeddedResource Include="Graphics\Fonts\CarlitoBare-Regular.ttf" />
    <EmbeddedResource Include="Internal\IO\DefaultTheme.xml" LogicalName="Aid.Xlsx.DefaultTheme.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\.editorconfig" Link=".editorconfig" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\..\third-party\LICENSE-Apache-2.0.txt" Pack="true" PackagePath="third-party\" />
    <None Include="..\..\third-party\LICENSE-Formula.txt" Pack="true" PackagePath="third-party\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ExcelNumberFormat" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Polyfill">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="RBush.Signed" />
    <PackageReference Include="SixLabors.Fonts" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aid.Xlsx.Opc\Aid.Xlsx.Opc.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Aid.Xlsx.Formula\Aid.Xlsx.Formula.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Aid.Xlsx.Generators\Aid.Xlsx.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
