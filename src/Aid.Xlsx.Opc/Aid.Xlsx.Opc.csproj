<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OPC/XML layer: the package container, relationships, content types, XML/MCE primitives.
    It knows nothing about the Excel model; the TFM and shared properties come from
    Directory.Build.props, IsLibrary turns on the library-wide trim/AOT settings and analyzers.
  -->

  <PropertyGroup>
    <RootNamespace>Aid.Xlsx.Opc</RootNamespace>
    <AssemblyName>Aid.Xlsx.Opc</AssemblyName>
    <IsLibrary>true</IsLibrary>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Polyfill">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
