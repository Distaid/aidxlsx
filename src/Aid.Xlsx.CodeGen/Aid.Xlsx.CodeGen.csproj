<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console XSD codegen: generates the readers and writers of OOXML parts.
    A build-time tool that never ships in the package; it does not need the library trim/AOT settings.
    The TFM and shared properties come from Directory.Build.props.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Aid.Xlsx.CodeGen</RootNamespace>
    <AssemblyName>Aid.Xlsx.CodeGen</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- The generator uses types from the OPC layer (the Aid.Xlsx.Opc namespace). -->
  <ItemGroup>
    <Using Include="Aid.Xlsx.Opc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aid.Xlsx.Opc\Aid.Xlsx.Opc.csproj" />
  </ItemGroup>
</Project>
